{
  "name": "mini-ups-nlq-mcp-server",
  "version": "1.0.0",
  "description": "Intelligent natural-language query MCP server using OpenRouter LLMs for intent recognition and answer generation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "benchmark": "node dist/benchmark/run-evaluation.js"
  },
  "keywords": [
    "mcp",
    "nlq",
    "natural-language-query",
    "mini-ups",
    "openrouter",
    "llm",
    "intent-recognition",
    "orchestrator"
  ],
  "author": "Mini-UPS Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "zod": "^3.22.0",
    "openai": "^4.28.0",
    "bottleneck": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
