# NLQ MCP Server Configuration

# ===== MCP Server Basic Settings =====
MCP_SERVER_NAME=mini-ups-nlq-mcp-server
MCP_SERVER_VERSION=1.0.0
NODE_ENV=development

# ===== OpenRouter LLM Configuration =====
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://mini-ups.local
OPENROUTER_APP_NAME=Mini-UPS-NLQ

# Model Selection Strategy
# Fast/Cheap models for intent parsing and planning
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
OPENROUTER_MODEL_FAST_FALLBACK=meta-llama/llama-3.1-8b-instruct:free

# Strict JSON models for structured output
OPENROUTER_MODEL_STRICT=openai/gpt-4o-mini
OPENROUTER_MODEL_STRICT_FALLBACK=google/gemini-1.5-flash

# High-quality models for answer generation
OPENROUTER_MODEL_ANSWER=openai/gpt-4o
OPENROUTER_MODEL_ANSWER_FALLBACK=google/gemini-1.5-pro

# ===== Backend API Configuration =====
BACKEND_BASE_URL=http://localhost:8081
BACKEND_API_TIMEOUT=10000
BACKEND_API_RETRIES=3
BACKEND_API_RETRY_DELAY=1000

# Optional: Amazon service base URL (for baseUrlOverride="amazon")
AMAZON_BASE_URL=http://localhost:8080

# Authentication for backend (optional)
BACKEND_AUTH_TOKEN=
BACKEND_API_KEY=

# ===== Rate Limiting & Cost Control =====
# Token bucket rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_BURST_SIZE=10

# Cost control (rough estimates in USD)
COST_BUDGET_ENABLED=true
COST_BUDGET_DAILY_LIMIT=5.00
COST_BUDGET_WARNING_THRESHOLD=4.00

# Request timeouts
LLM_REQUEST_TIMEOUT_FAST=3000
LLM_REQUEST_TIMEOUT_STRICT=8000
LLM_REQUEST_TIMEOUT_ANSWER=15000

# ===== Security & Privacy =====
# PII masking settings
PII_MASKING_ENABLED=true
PII_MASK_EMAIL=true
PII_MASK_PHONE=true
PII_MASK_ADDRESS=true
PII_MASK_TRACKING_NUMBERS=false

# Logging settings
LOG_LEVEL=info
LOG_FORMAT=json
LOG_PII_ENABLED=false
LOG_TOKENS_ENABLED=true

# ===== Caching Configuration =====
CACHE_ENABLED=true
CACHE_TTL_INTENT_PARSING=300000    # 5 minutes
CACHE_TTL_BACKEND_RESPONSE=60000   # 1 minute
CACHE_TTL_FINAL_ANSWER=180000      # 3 minutes
CACHE_MAX_SIZE=1000

# ===== Query Constraints =====
# Result limits to prevent abuse
MAX_RESULTS_PER_QUERY=100
MAX_PAGINATION_SIZE=50
MAX_DATE_RANGE_DAYS=90
MAX_CONCURRENT_BACKEND_CALLS=5

# Intent recognition confidence thresholds
INTENT_CONFIDENCE_THRESHOLD=0.7
FALLBACK_TO_GENERIC_THRESHOLD=0.5

# ===== Development & Testing =====
# Mock LLM responses for testing
MOCK_LLM_ENABLED=false
MOCK_BACKEND_ENABLED=false

# Evaluation mode
EVALUATION_MODE=false
EVALUATION_DATASET_PATH=./tests/fixtures/evaluation-dataset.json

# Debug options
DEBUG_INTENT_PARSING=false
DEBUG_BACKEND_CALLS=false
DEBUG_ANSWER_GENERATION=false
